# Copy this file to ".env" and fill in SM_TOKEN. Never commit ".env".

# REQUIRED. Secret used to access the stream (min 16 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SM_TOKEN=

# TCP port to listen on (on the Tailscale IP only).
SM_PORT=8787

# Monitor to mirror, as numbered by mss: 1 = first monitor, 2 = second, ...
# 0 = all monitors combined into one image.
SM_MONITOR=1

# Frames per second (1-60). Lower = less CPU and less data.
SM_FPS=30

# JPEG quality (10-95). Lower = smaller frames, blurrier picture.
SM_JPEG_QUALITY=70

# Resolution scale (0.1-1.0). 0.5 = half width and half height (~1/4 the pixels).
# 0.5 and 0.25 are the fastest to compute.
SM_SCALE=0.75

# Max simultaneous viewers (each one holds a server thread).
SM_MAX_CLIENTS=3

# Draw the mouse pointer on the stream (mss does not capture it itself). 1 or 0.
SM_CURSOR=1

# Also listen on 127.0.0.1 (this PC only). Needed for `tailscale serve` HTTPS, which
# is what lets the phone install the app as a real PWA. See README.
SM_LOOPBACK=0

# Screen grabbing method: auto (fast DXGI, falls back to mss), dxgi, or mss.
SM_CAPTURE=auto

# Let phones listen to this PC's sound (each phone must also switch it on in its own settings; off by default).
# Nothing is recorded while nobody listens. Set 0 to forbid it completely.
SM_AUDIO=1

# Look for new releases on GitHub every 12 hours and show "Update available" in the app.
# This only contacts api.github.com; set 0 to turn it off. Updating is always done by you: `samantha-mirror update`.
SM_UPDATE_CHECK=1
