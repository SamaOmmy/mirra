<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- light; values-night has the dark look -->
    <style name="Mirra" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#6a4cf5</item>
        <item name="android:colorPrimary">#F5F6FA</item>
        <item name="android:colorPrimaryDark">#F5F6FA</item>
        <item name="android:windowBackground">#F5F6FA</item>
        <item name="android:statusBarColor">#F5F6FA</item>
        <item name="android:navigationBarColor">#F5F6FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- the full-screen PC view is always dark, like a video player -->
    <style name="Mirra.Fullscreen" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
